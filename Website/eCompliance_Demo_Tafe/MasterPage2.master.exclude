        .style12
        {
            height: 327px;
            width: 208px;
            visibility: visible;
        }
        .style14
        {
            height: 327px;
        }
        .style15
        {
            width: 82%;
        }
        .style17
        {
            width: 183px;
            height: 32px;
        }
        .style19
        {
            width: 183px;
            height: 37px;
        }
    </style>
</head>
<body oncontextmenu="return false" 
    style="background: url(Images/MasterPage.JPG) no-repeat; height: 729px;">
     <%--<body oncontextmenu="return false" 
    style="background: url(~/Images/RaneLogo1.jpg) no-repeat; height: 729px;">--%>
    <form id="form1" runat="server">
   
    <div class="wrap">
