<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="ReportDirectory" value="D:\Source Code\Solutions\GaniniMailingService\GeneratingMail\Reports\"/>
    <!--<add key="TestFile" value= "D:\Test.txt"/>--> <!--"D:\ActivityMailLog.txt"/>-->
    <add key="TestFile" value="D:\LogFile\DailyLog"/>  <!--.txt will be added in program after padding the dateand time scs 120816-->
    <add key="SleepingTime" value="60"/><!--in seconds-->
    <add key="Frequency" value="4"/>
    <add key="LogFile" value="D:\LogFile\Log-"/>
    <add key="IP" value="192.168.120.153"/>
    <add key="_Port" value="25"/>
    <add key="FromMail" value="support@ganini.co.in"/>
    <add key="BodyMessage1" value=" For details login to Stack System."/>
    <add key="BodyMessage2" value=" This Email is AutoGenerated by Stack System. kindly do not reply on this mail."/>
       
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
    <!--Mail Flag settings-->
    <add key="AllMails" value="0"/>
    <add key="IsDailyProcess" value="Y"/><!--Process for Creating New Activity Action-->
    <add key="ProcessDate" value="1"/><!-- set the date on which Activity action created// madhavi 14/02/13 -->
    <add key="TriggerDateMonth" value="1"/>
    <add key="RedAlertDay" value="1"/>
    <add key="ReviewerColRequired" value="N"/>
    <add key="ExecutionColRequired" value="N"/>
    
    <add key="IsDaily" value="Y"/><!--If the Mail to be Send Daily then IsDaily should be Y else N-->    
    <add key="IsWeekly" value="N"/><!--If the Mail to be Send Weekly then IsWeekly should be Y else N-->
    <add key="WeekDay" value="Tuesday"/>
    <add key="MailHour" value="13"/>
    <add key="WeekDay1" value="Thursday"/> <!--For Weekfrequency 2-->
    <add key="WeekDay2" value="Wednesday"/><!--For Weekfrequency 3-->
    <add key="WeekDay3" value="Friday"/><!--For Weekfrequency 3-->
    <add key="WeekFrequency" value="1"/><!--how many times in a week Mail to be sent-->
    <!-- Red Alert Email-->
    <add key="MailTo" value="chandru@ganini.com"/>
    <add key="MailCC" value=""/>
    <add key="AttachFilePath" value="D:\Overdue Pending Activities.xls"/>
    <add key="Subject"  value="Regarding Synchronising ACTS"/>
    <add key="BodyMessage" value="Pls."/>
    <add key="IsExcel" value="N"/>

    <add key="TestingFlag" value="Y"/>
    <add key="WebServer" value="AB"/>
    <add key="AutoActUpDate" value="N"/> <!--Set to Y if Auto update for ACts from webserver is sought-->
    <add key="IsDev" value="y"/>
    <add key="ClGud" value="TAFECompliance"/>
    <add key="Bhadram" value="padh1"/>
    
    <!--Traces Configuration Starts-->
    <add key="GCustTrace_logfile" value="D:\Source Code\Traces\WinTraces"/>
    <add key="GCustTrace_ErrorCategoryList" value="Error,Data" />
    <add key="GCustTrace_LogFullstack" value="off" />
    <add key="GMaximumRequests" value="2" />
    <!--Traces Configuration Ends-->
  </appSettings>
  <system.diagnostics>
    <!-- Custom Logging and Tracing -->
    <switches>
      <add name="GMySwitch" value="4" />
    </switches>
    <trace autoflush="true" indentsize="2">
      <listeners>
        <add name="GDBTL" type="Ganini.Diagnostics.DatabaseTraceListener,GCustomTraceListeners" />
        <add name="GFileTL" type="Ganini.Diagnostics.FileTraceListener,GCustomTraceListeners" />
      </listeners>
    </trace>
  </system.diagnostics>
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source=CHANDRU-PC\SQL14;Initial Catalog=eCompliance;uid=appuser;pwd=ganini@123" providerName="System.Data.SqlClient"/>
    <add name="GCustTrace_DbConnectionString" connectionString="Data Source=CHANDRU-PC\SQL14;Initial Catalog=eCompliance;uid=appuser;pwd=ganini@123" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri=""/>
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400"/>
      </providers>
    </roleManager>
  </system.web>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0,Profile=Client"/></startup>
  

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IService1" closeTimeout="00:40:00" openTimeout="00:40:00" receiveTimeout="00:40:00" sendTimeout="00:40:00" allowCookies="false" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="2147483647" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647" textEncoding="utf-8" transferMode="Buffered" useDefaultWebProxy="true" messageEncoding="Text">
          <readerQuotas maxDepth="32" maxStringContentLength="8192" maxArrayLength="2147483647" maxBytesPerRead="4096" maxNameTableCharCount="16384"/>
          <security mode="None">
            <transport clientCredentialType="None" proxyCredentialType="None" realm=""/>
            <message clientCredentialType="UserName" algorithmSuite="Default"/>
          </security>
        </binding>
      </basicHttpBinding>
    </bindings>
    <!--<client>
      <endpoint address="http//www.ganiniinfotech.in/WCFCoupon/Service.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IService1"
        contract="WCFcouponReference.IService1" name="BasicHttpBinding_IService1" />
    </client>-->
    <client>
      <endpoint address="http://localhost:1551/WebWCFAct/Service.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IService1" contract="WebActService.IService1" name="BasicHttpBinding_IService1"/>
    </client>
  </system.serviceModel>
  
</configuration>
